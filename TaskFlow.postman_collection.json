      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/stats/monthly?month=2026-10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "stats",
            "monthly"
          ],
          "query": [
            {
              "key": "month",
              "value": "2026-10"
            }
          ]
