    },
    {
      "name": "Delete habit",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/habits/{{habitId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "habits",
