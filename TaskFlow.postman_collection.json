            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Exercise 45 min\"\n}"
        }
      }
    },
    {
      "name": "Pause habit",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/habits/{{habitId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "habits",
            "{{habitId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"active\": false\n}"
        }
      }
    },
    {
      "name": "Resume habit",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/habits/{{habitId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "habits",
